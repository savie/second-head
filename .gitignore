# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Expo / React Native ---
.expo/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.hprof
.android/
.ios/

# --- Supabase & Edge Functions ---
.env
.env.*
!.env.example
supabase/.temp/
supabase/.branches/
supabase/functions/*/node_modules/

# --- Testing & Coverage ---
coverage/
*.lcov
.jest-cache/

# --- OS & Environment ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Build & Misc ---
build/
out/
target/
*.log
local.properties