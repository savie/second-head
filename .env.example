# ============================================================
# SECOND HEAD — SYSTEM BUILD
# .env.example — Environment & Secrets Convention (BL-P0-007)
# Phase 0 — Infrastructure & Development Foundation
#
# CONVENTION:
# - File ini TEMPLATE. JANGAN isi nilai asli di file ini.
# - Salin ke .env untuk lokal; .env WAJIB tetap di .gitignore (sudah).
# - Nilai asli TIDAK BOLEH masuk: Git, source code, logs, memory,
#   user response, atau plaintext database.
# - Klasifikasi:
#   [PUBLIC]  boleh terekspos ke client (Expo) via EXPO_PUBLIC_*;
#             tetap tidak boleh di-hardcode di source.
#   [SECRET]  WAJIB hanya di runtime secret store
#             (Supabase Edge Function secrets / CI secrets).
#   [CONFIG]  non-secret runtime configuration (opsional).
# ============================================================

# ------------------------------------------------------------
# [PUBLIC] Client (React Native Expo)
# ------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_PLACEHOLDER

# ------------------------------------------------------------
# [SECRET] Backend / Edge Functions (Deno) — JANGAN masuk client
# ------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_PLACEHOLDER
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_PLACEHOLDER
GROQ_API_KEY=YOUR_GROQ_API_KEY_PLACEHOLDER

# ------------------------------------------------------------
# [CONFIG] Non-secret runtime configuration (opsional)
# ------------------------------------------------------------
APP_ENV=development
# AI_MODEL_ID=llama-3.1-8b-instant